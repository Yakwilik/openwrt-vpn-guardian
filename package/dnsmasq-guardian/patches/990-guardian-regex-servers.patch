+#define REGEX_SERVER_PREFIX "regex:"
+#define REGEX_SERVER_PREFIX_LEN (sizeof(REGEX_SERVER_PREFIX) - 1)
+#define REGEX_SERVER_MAX_LENGTH 4096
+
+/* Local records share only the prefix of struct server. Never inspect regex
+   on one of those shorter allocations. */
+static int server_is_regex(struct server *serv)
+{
+  return !(serv->flags & SERV_IS_LOCAL) && serv->regex != NULL;
+}
+
+static void free_server_regex(struct server *serv)
+{
+  if (server_is_regex(serv))
+    {
+      regfree(serv->regex);
+      free(serv->regex);
+      serv->regex = NULL;
+    }
+}
