+/* Match the same lowercase, escaped presentation as miekg/dns. In particular,
+   embedded dots are distinct from label separators, non-printable bytes use
+   decimal escapes, and an escaped space still contains a literal space. */
+static int regex_query_name(const char *domain, char *out, size_t capacity)
+{
+  const unsigned char *p = (const unsigned char *)domain;
+  size_t used = 0;
+
+  while (*p)
+    {
+      unsigned char c = *p++;
+      int separator = c == '.';
+
+      if (c == NAME_ESCAPE)
+        {
+          if (!*p)
+            return 0;
+          c = (*p++) - 1;
+        }
+
+      if (used + 4 >= capacity)
+        return 0;
+
+      if (c >= 'A' && c <= 'Z')
+        c += 'a' - 'A';
+
+      if (!separator && (c == '.' || c == ' ' || c == '\'' || c == '@' ||
+                         c == ';' || c == '(' || c == ')' || c == '"' || c == '\\'))
+        out[used++] = '\\';
+
+      if (c < ' ' || c > '~')
+        {
+          out[used++] = '\\';
+          out[used++] = '0' + c / 100;
+          out[used++] = '0' + (c / 10) % 10;
+          out[used++] = '0' + c % 10;
+        }
+      else
+        out[used++] = c;
+    }
+
+  out[used] = 0;
+  return 1;
+}
+
+/* C locale makes POSIX character classes/ranges stable independently of DHCP
+   internationalisation settings. It is process-lifetime state, not per query. */
+static locale_t server_regex_locale;
+
+static int lookup_regex_domain(char *domain, int flags, int *lowout, int *highout)
+{
+  char name[(MAXDNAME * 4) + 1];
+  int i, first = 0, last = 0, best_serial = INT_MAX;
+  locale_t previous;
+
+  if ((flags & F_CONFIG) || daemon->serverarray_native == daemon->serverarraysz)
+    return 0;
+
+  if (!regex_query_name(domain, name, sizeof(name)))
+    goto failed;
+
+  previous = uselocale(server_regex_locale);
+
+  for (i = daemon->serverarray_native; i < daemon->serverarraysz; i++)
+    {
+      struct server *serv = daemon->serverarray[i];
+      int low, high, rc;
+
+      /* Equivalent upstreams are one selector; preserve declaration order
+         between selectors and native --strict-order within their groups. */
+      if ((i > daemon->serverarray_native &&
+           order_servers(daemon->serverarray[i-1], serv) == 0) ||
+          serv->serial >= best_serial)
+        continue;
+
+      rc = regexec(serv->regex, name, 0, NULL, 0);
+      if (rc != 0 && rc != REG_NOMATCH)
+        {
+          uselocale(previous);
+          my_syslog(LOG_ERR, _("regex server match failed; refusing DNS query"));
+          goto failed;
+        }
+
+      if (rc == 0 && filter_servers(i, flags, &low, &high))
+        {
+          best_serial = serv->serial;
+          first = low;
+          last = high;
+        }
+    }
+
+  uselocale(previous);
+
+  if (first == last)
+    return 0;
+
+  if (lowout)
+    *lowout = first;
+  if (highout)
+    *highout = last;
+  return 1;
+
+ failed:
+  if (lowout)
+    *lowout = 0;
+  if (highout)
+    *highout = 0;
+  return -1;
+}
