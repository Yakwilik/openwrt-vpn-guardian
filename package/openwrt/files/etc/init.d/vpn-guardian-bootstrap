#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=3

MARKER=/etc/vpn-stack/bootstrap-complete
LOG=/tmp/vpn-guardian-bootstrap.log

start_service() {
  [ -f "$MARKER" ] && return 0

  procd_open_instance vpn-guardian-bootstrap
  procd_set_param command /bin/sh -c 'while [ ! -f /etc/vpn-stack/bootstrap-complete ]; do
    if ! /usr/bin/vpn-guardian bootstrap >>/tmp/vpn-guardian-bootstrap.log 2>&1; then
      logger -t vpn-guardian-bootstrap "bootstrap failed; see /tmp/vpn-guardian-bootstrap.log"
      exit 1
    fi
    [ -f /etc/vpn-stack/bootstrap-complete ] && exit 0
    sleep 15
  done'
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
