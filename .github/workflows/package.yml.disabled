name: OpenWrt package

on:
  workflow_dispatch:
  push:
    branches: ["main"]
    paths:
      - "cmd/**"
      - "internal/**"
      - "configs/**"
      - "package/openwrt/**"
      - "go.mod"
      - "go.sum"
      - ".github/workflows/package.yml"
  pull_request:
    paths:
      - "cmd/**"
      - "internal/**"
      - "configs/**"
      - "package/openwrt/**"
      - "go.mod"
      - "go.sum"
      - ".github/workflows/package.yml"

env:
  OPENWRT_VERSION: "24.10.4"
  OPENWRT_TARGET: "mediatek"
  OPENWRT_SUBTARGET: "filogic"
  SDK_FILE: "openwrt-sdk-24.10.4-mediatek-filogic_gcc-13.3.0_musl.Linux-x86_64.tar.zst"
  SDK_SHA256: "b9762b8e1c8e114b0e6a252b98e94e6e4a1d2496beb9f6044c26227a8d78dee0"

jobs:
  ipk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install host tools
        run: sudo apt-get update && sudo apt-get install -y zstd rsync file binutils

      - name: Download OpenWrt SDK
        run: |
          curl -fL --retry 3             -o /tmp/openwrt-sdk.tar.zst             "https://downloads.openwrt.org/releases/${OPENWRT_VERSION}/targets/${OPENWRT_TARGET}/${OPENWRT_SUBTARGET}/${SDK_FILE}"
          echo "${SDK_SHA256}  /tmp/openwrt-sdk.tar.zst" | sha256sum -c -
          mkdir -p /tmp/openwrt-sdk
          tar --zstd -xf /tmp/openwrt-sdk.tar.zst -C /tmp/openwrt-sdk --strip-components=1

      - name: Prepare exact source and package
        shell: bash
        run: |
          set -euo pipefail
          rm -rf /tmp/vpn-guardian.git
          git clone --bare "${GITHUB_WORKSPACE}" /tmp/vpn-guardian.git

          cd /tmp/openwrt-sdk
          ./scripts/feeds update -a
          ./scripts/feeds install -a
          rm -rf package/vpn-guardian
          cp -a "${GITHUB_WORKSPACE}/package/openwrt" package/vpn-guardian

          head_sha="$(git -C "${GITHUB_WORKSPACE}" rev-parse HEAD)"
          sed -i "s|^PKG_SOURCE_URL:=.*|PKG_SOURCE_URL:=file:///tmp/vpn-guardian.git|" package/vpn-guardian/Makefile
          sed -i "s|^PKG_SOURCE_VERSION:=.*|PKG_SOURCE_VERSION:=${head_sha}|" package/vpn-guardian/Makefile

          make defconfig

      - name: Build vpn-guardian ipk
        working-directory: /tmp/openwrt-sdk
        run: |
          make package/vpn-guardian/compile V=s

      - name: Collect package
        run: |
          mkdir -p dist
          find /tmp/openwrt-sdk/bin -type f -name 'vpn-guardian_*.ipk' -exec cp -v {} dist/ \;
          test -n "$(find dist -type f -name 'vpn-guardian_*.ipk' -print -quit)"

      - name: Verify packaged binary is CGO-free and static
        shell: bash
        run: |
          set -euo pipefail
          ipk="$(find dist -type f -name 'vpn-guardian_*.ipk' -print -quit)"
          rm -rf /tmp/vpn-guardian-ipk-check
          mkdir -p /tmp/vpn-guardian-ipk-check
          cd /tmp/vpn-guardian-ipk-check
          ar x "$GITHUB_WORKSPACE/$ipk"
          data="$(find . -maxdepth 1 -type f -name 'data.tar.*' -print -quit)"
          test -n "$data"
          tar -xf "$data"
          test -x usr/bin/vpn-guardian
          file usr/bin/vpn-guardian
          file usr/bin/vpn-guardian | grep -q "statically linked"
          if readelf -d usr/bin/vpn-guardian 2>/dev/null | grep -q NEEDED; then
            echo "vpn-guardian unexpectedly has dynamic dependencies" >&2
            exit 1
          fi

      - uses: actions/upload-artifact@v4
        with:
          name: vpn-guardian-openwrt-24.10.4-filogic
          path: dist/*.ipk
